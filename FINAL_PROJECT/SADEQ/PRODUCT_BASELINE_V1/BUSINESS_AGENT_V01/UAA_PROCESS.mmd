flowchart TB
 Start(["Start: approved business event"]) --> B01["ALG-01: verify sender, tenant, schema and flow"]
 B01 --> V{"valid?"}
 V -- no --> REJ["REJECT + reason code + audit"]
 V -- yes --> D["ALG-02: check idempotency"]
 D --> Dup{"Already accepted?"}
 Dup -- yes --> Noop["Return existing event receipt; no duplicate side effects"]
 Dup -- no --> M["ALG-03: resolve exact canonical object"]
 M --> Amb{"One permitted object?"}
 Amb -- no --> Rev["ABSTAIN / human entity review"]
 Amb -- yes --> J["ALG-04: append immutable observation + event"]
 J --> State["ALG-05: deterministic event reducer and replay"]
 State --> Diff["ALG-06: evaluate domain threshold / transition"]
 Diff --> Trigger{"Threshold crossed?"}
 Trigger -- no --> End(["Close with stored evidence"])
 Trigger -- yes --> Know["ALG-07: retrieve ACL-bound vector + graph + citations"]
 Know --> Hyp["ALG-08: formulate evidence-backed hypotheses"]
 Hyp --> Forecast["ALG-09: compute reproducible forecast/backtest"]
 Forecast --> Propose["ALG-10: DMN rules → action proposal or ABSTAIN"]
 Propose --> Auth["ALG-11: UAG policy and qualification check"]
 Auth --> Policy{"DENY / REQUIRE_APPROVAL / ALLOW_BOUNDED"}
 Policy -- DENY --> REJ
 Policy -- REQUIRE_APPROVAL --> H{"Human approved fixed action hash?"}
 H -- no --> REJ
 H -- yes --> Reval["Recheck object version, TTL, rights, action parameters"]
 Policy -- ALLOW_BOUNDED --> Reval
 Reval --> Fresh{"Still valid?"}
 Fresh -- no --> REJ
 Fresh -- yes --> Execute["UAG: idempotent scoped tool call"]
 Execute --> Confirm["ALG-12: compare expected and observed result"]
 Confirm --> OK{"Verified?"}
 OK -- no --> Incident["Record mismatch, prevent blind retry, escalate"]
 OK -- yes --> Feedback["Record audit, feedback, metric, provenance"]
 Feedback --> End
