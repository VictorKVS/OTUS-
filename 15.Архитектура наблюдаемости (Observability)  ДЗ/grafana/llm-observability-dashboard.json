{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "LLM request rate",
      "targets": [{"expr": "sum(rate(llm_requests_total[5m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Error rate",
      "targets": [{"expr": "sum(rate(llm_errors_total[5m])) / clamp_min(sum(rate(llm_requests_total[5m])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(llm_request_duration_seconds_bucket[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Token rate",
      "targets": [
        {"expr": "sum(rate(llm_input_tokens_total[5m]))", "legendFormat": "input", "refId": "A"},
        {"expr": "sum(rate(llm_output_tokens_total[5m]))", "legendFormat": "output", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Security and safety events",
      "targets": [{"expr": "sum by (type) (rate(llm_guardrail_triggers_total[5m]))", "legendFormat": "{{type}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ],
  "schemaVersion": 39,
  "tags": ["llm", "observability", "security", "father"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "FATHER LLM Observability",
  "uid": "father-llm-observability",
  "version": 1
}
