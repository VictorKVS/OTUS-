      "db": [
        "DB-PROJECT",
        "DB-GRAPH"
      ],
      "kb": [
        "KB-REQUIREMENTS",
        "KB-PROJECT",
        "KB-DATA"
      ],
      "output": [
        [
          "📋",
          "Analysis Pack"
        ],
        [
          "✅",
          "Acceptance Criteria"
        ],
        [
          "🔗",
          "Traceability"
        ]
      ],
      "next": [
        "S30"
      ]
    },
    {
      "id": "S30",
      "icon": "🏛️",
      "name": "Architect",
      "agent": "FTH-AG-ARC-001",
      "input": [
        "Analysis Pack"
      ],
      "db": [
        "DB-PROJECT",
        "DB-GRAPH",
        "DB-CONFIG"
      ],
      "kb": [
        "KB-ARCHITECTURE",
        "KB-REQUIREMENTS",
        "KB-SECURITY"
      ],
      "output": [
        [
          "🧩",
          "Architecture Pack"
        ],
        [
          "📝",
          "ADR"
        ],
        [
          "🗺️",
          "C4 / LLD"
        ]
      ],
      "next": [
        "S35",
        "S40"
      ]
