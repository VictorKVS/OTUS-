      "icon": "🧠",
      "name": "Knowledge Curator",
      "agent": "FTH-AG-KNW-001",
      "input": [
        "new sources",
        "approved artifacts",
        "production findings"
      ],
      "db": [
        "DB-OBJECT",
        "DB-VECTOR",
        "DB-GRAPH"
      ],
      "kb": [
        "KB-SOURCES",
        "KB-PROJECT",
        "KB-EVIDENCE"
      ],
      "output": [
        [
          "🧠",
          "Indexed Knowledge"
        ],
        [
          "🔗",
          "Provenance Links"
        ]
      ],
      "next": [
        "all"
      ]
    },
    {
