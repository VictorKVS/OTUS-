    {
      "id": "S35",
      "icon": "🔌",
      "name": "Data / Integration",
      "agent": "FTH-AG-DAT-001",
      "input": [
        "Architecture slice",
        "data/integration requirements"
      ],
      "db": [
        "DB-PROJECT",
        "DB-ARTIFACT"
      ],
      "kb": [
        "KB-DATA",
        "KB-ARCHITECTURE"
      ],
      "output": [
        [
          "🔌",
          "API Contracts"
        ],
        [
          "🗃️",
          "Data Model"
        ],
        [
          "📨",
          "Event Contracts"
        ]
      ],
      "next": [
        "S40"
      ]
