{
  "schema_version": "father-factory.v1",
  "title": "FATHER Factory",
  "status": "M0 scaffold",
  "principle": "Every station has explicit inputs, agent, data stores, knowledge bases, outputs and next destination.",
  "input_ports": [
    {
      "id": "IN-IDEA",
      "icon": "💡",
      "name": "Idea / Request",
      "accepts": [
        "text",
        "voice-note",
        "brief"
      ]
    },
    {
      "id": "IN-DOC",
      "icon": "📄",
      "name": "Documents",
      "accepts": [
        "pdf",
        "docx",
        "xlsx",
        "md",
        "images"
      ]
    },
    {
      "id": "IN-CODE",
      "icon": "💻",
      "name": "Existing Code / Repo",
      "accepts": [
        "git",
        "zip",
        "source tree"
      ]
    },
    {
      "id": "IN-DATA",
      "icon": "🗃️",
      "name": "Data",
      "accepts": [
        "csv",
        "json",
        "sql",
        "db dump",
        "samples"
      ]
    },
    {
      "id": "IN-API",
      "icon": "🔌",
      "name": "API / Integration",
      "accepts": [
        "openapi",
        "asyncapi",
        "docs",
        "credentials reference"
      ]
    },
    {
      "id": "IN-CONSTRAINT",
      "icon": "⚠️",
      "name": "Constraints",
      "accepts": [
        "deadline",
        "budget",
        "security",
        "infra",
        "regulation"
      ]
    }
  ],
  "data_stores": [
    {
      "id": "DB-PROJECT",
      "icon": "🗄️",
      "name": "Project DB",
      "kind": "PostgreSQL",
      "status": "placeholder",
      "purpose": "Projects, stages, owners, statuses, registers, metadata."
    },
    {
      "id": "DB-VECTOR",
      "icon": "🧬",
      "name": "Vector DB",
      "kind": "pgvector/Qdrant TBD",
      "status": "placeholder",
      "purpose": "Embeddings and semantic retrieval collections."
    },
    {
      "id": "DB-GRAPH",
      "icon": "🕸️",
      "name": "Graph DB",
      "kind": "AGE/graph backend TBD",
      "status": "placeholder",
      "purpose": "Traceability and entity-relation graph."
    },
    {
      "id": "DB-OBJECT",
      "icon": "🪣",
      "name": "Object Store",
      "kind": "filesystem/S3-compatible TBD",
      "status": "placeholder",
      "purpose": "Original documents, media, binaries and large artifacts."
    },
    {
      "id": "DB-ARTIFACT",
      "icon": "📦",
      "name": "Artifact Registry",
      "kind": "Git/packages/builds TBD",
      "status": "placeholder",
      "purpose": "Builds, schemas, packages, release artifacts."
    },
    {
      "id": "DB-EVIDENCE",
      "icon": "🧾",
      "name": "Evidence Store",
      "kind": "append-only TBD",
      "status": "placeholder",
      "purpose": "Test reports, validation results, hashes, screenshots and benchmark evidence."
    },
    {
      "id": "DB-OBS",
      "icon": "📡",
      "name": "Observability Store",
      "kind": "metrics/logs/traces TBD",
      "status": "placeholder",
      "purpose": "Runtime metrics, logs, traces, incidents."
    },
    {
      "id": "DB-CONFIG",
      "icon": "⚙️",
      "name": "Registry / Config DB",
      "kind": "YAML/DB TBD",
      "status": "placeholder",
      "purpose": "Agent/model/tool/config registries and versioned policies."
    }
  ],
  "stations": [
    {
      "id": "S00",
      "icon": "🧭",
      "name": "Supervisor / Router",
      "agent": "FTH-AG-SUP-001",
      "input": [
        "all factory events"
      ],
      "db": [
        "DB-PROJECT",
        "DB-CONFIG"
      ],
      "kb": [
        "KB-PROJECT",
        "KB-TRACE"
      ],
      "output": [
        [
          "🧭",
          "Route / Handoff"
        ]
      ],
      "next": [
        "S10",
        "S20",
        "S30",
        "S40"
      ]
    },
    {
      "id": "S10",
      "icon": "📥",
      "name": "Intake",
      "agent": "FTH-AG-INT-001",
      "input": [
        "IN-IDEA",
        "IN-DOC",
        "IN-CODE",
        "IN-DATA",
        "IN-API",
        "IN-CONSTRAINT"
      ],
      "db": [
        "DB-PROJECT",
        "DB-OBJECT"
      ],
      "kb": [
        "KB-SOURCES",
        "KB-PROJECT",
        "KB-REGULATORY"
      ],
      "output": [
        [
          "📘",
          "Intake Pack"
        ],
        [
          "❓",
          "Open Questions"
        ],
        [
          "🏷️",
          "Classification"
        ]
      ],
      "next": [
        "S20"
      ]
    },
