    "analytical_core": "ALINA / FATHER Analytical Core",
    "common_knowledge": "K0 Common Knowledge",
    "dossier": "C00-C99 Controlled Dossier",
    "lab": "FATHER LAB",
    "operations": "DevOps / Environments",
    "regulations": [
      "Factory regulation",
      "Workshop regulation",
      "Product profile / tailoring"
    ],
    "laws": [
      "NO_REGULATION_NO_PROCESS",
      "NO_TEST_NO_CLAIM_OF_QUALITY",
      "NO_EVIDENCE_NO_PROMOTION",
      "NO_ACCEPTANCE_NO_RELEASE"
    ],
    "contracts": "factory/data/contract-registry.json",
    "provenance_innovation": "factory/data/innovation-provenance-registry.json",
    "pro_gate": "G-PRO-IP-PROVENANCE",
    "pro_rule": "PRO/PATENT_CANDIDATE/COMMERCIAL_RELEASE require versioned contracts, provenance, rights/license review, analogue search, decomposition comparison and independent review."
  },
  "flow": {
    "ingress": "INPUT",
    "workshops": [
      {
        "id": "W00",
        "name": "INTAKE",
        "purpose": "Register and classify incoming work."
      },
      {
        "id": "W10",
        "name": "ANALYSIS",
        "purpose": "Transform raw information into requirements, facts, risks and traceability."
      },
      {
        "id": "W20",
        "name": "ARCHITECTURE",
        "purpose": "Transform validated requirements into architecture and Development Pack."
      },
      {
        "id": "W30",
        "name": "KNOWLEDGE_DATA",
        "purpose": "Prepare governed knowledge, data, datasets and contracts."
      },
      {
        "id": "W40",
        "name": "AGENT_COMPONENT_ENGINEERING",
        "purpose": "Select REUSE/ADAPT/NEW components, Agent Kits, models and tools."
      },
      {
        "id": "W50",
        "name": "IMPLEMENTATION",
        "purpose": "Produce code/configuration from approved design."
      },
      {
        "id": "W60",
        "name": "QA_SECURITY_LAB",
        "purpose": "Independently prove functional, quality and security properties."
      },
      {
        "id": "W70",
        "name": "DEVOPS_ENVIRONMENTS",
        "purpose": "Build, package, deploy and operate with evidence."
      },
      {
        "id": "W80",
        "name": "ACCEPTANCE_CERTIFICATION",
        "purpose": "Evaluate full evidence bundle and authorize promotion."
      },
      {
        "id": "W90",
        "name": "OUTPUT_DELIVERY",
        "purpose": "Deliver product plus complete controlled technical dossier."
      }
    ],
    "egress": "OUTPUT_BUNDLE",
    "feedback": "OUTPUT / EXPERIENCE → ANALYTICS → LAB → CHANGE REQUEST → K0/K1/K2 / BLOCK LIBRARY"
  },
