{
  "schema_version": "father-unified-system.v1",
  "status": "CANONICAL_DESIGN",
  "principle": "ONE_BASE_ONE_FACTORY_MANY_DOMAIN_BRANCHES",
  "definition": "FATHER transforms input information into a verified product through common workshops. Domain tabs are overlays on the same production system, not separate platforms.",
